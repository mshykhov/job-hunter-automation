{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "application-materials/v1/writing-style",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "voiceRules", "examples"],
  "properties": {
    "schemaVersion": { "const": "application-materials/v1" },
    "voiceRules": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "examples": { "type": "array", "minItems": 1 }
  }
}
