{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "application-materials/v1/fact-catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "summary", "qualifications", "experience"],
  "properties": {
    "schemaVersion": { "const": "application-materials/v1" },
    "summary": { "type": "array", "minItems": 2 },
    "qualifications": { "type": "array", "minItems": 4 },
    "experience": { "type": "array", "minItems": 1 }
  }
}
