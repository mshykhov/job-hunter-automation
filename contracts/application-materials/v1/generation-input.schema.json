{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "application-materials/v1/generation-input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "vacancy",
    "candidateProfile",
    "factCatalog",
    "writingStyle",
    "requestedKinds",
    "coverLetterPolicy",
    "mode"
  ],
  "properties": {
    "schemaVersion": { "const": "application-materials/v1" },
    "requestId": { "type": "string", "format": "uuid" },
    "vacancy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "source"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "company": { "type": ["string", "null"] },
        "description": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "candidateProfile": { "$ref": "candidate-profile.schema.json" },
    "factCatalog": { "$ref": "fact-catalog.schema.json" },
    "writingStyle": { "$ref": "writing-style.schema.json" },
    "requestedKinds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": ["CV_DOCX", "CV_PDF", "COVER_LETTER", "RECRUITER_MESSAGE"]
      }
    },
    "coverLetterPolicy": {
      "enum": ["OPTIONAL_STANDARD", "REQUIRED_STANDARD", "REQUIRED_EXTENDED"]
    },
    "mode": { "enum": ["TERRA", "SOL_IMPROVE", "USER_EDIT_VALIDATION"] }
  }
}
