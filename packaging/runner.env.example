JOB_HUNTER_API_URL=https://api-jobhunter.gaynance.com
AUTHENTIK_TOKEN_URL=https://auth.gaynance.com/application/o/token/
AUTOMATION_M2M_CLIENT_ID=
AUTOMATION_M2M_USERNAME=
AUTOMATION_M2M_PASSWORD=
BROWSER_PROFILE_DIR=/var/lib/job-hunter-automation/chrome-profile
CODEX_HOME=/var/lib/job-hunter-automation/codex
HEALTH_REPORTING_ENABLED=true
WORKFLOW_WORKER_ENABLED=false
WORKFLOW_WORKER_ID=private-runner
WORKFLOW_POLL_INTERVAL_MS=2000
WORKFLOW_STEP_DELAY_MS=1000
MATERIALS_ENABLED=false
MATERIALS_WORKER_ID=private-runner
MATERIALS_WORK_ROOT=/var/lib/job-hunter-automation/materials/work
MATERIALS_RENDERER_COMMAND=/opt/cv-materials/bin/cv-materials-render
MATERIALS_CV_PROFILE_PATH=/var/lib/job-hunter-automation/materials/profile/profile.yaml
MATERIALS_BASE_DOCX_PATH=/var/lib/job-hunter-automation/materials/profile/base-cv.docx
MATERIALS_BASE_PDF_PATH=/var/lib/job-hunter-automation/materials/profile/base-cv.pdf
MATERIALS_PROFILE_MANIFEST_PATH=/var/lib/job-hunter-automation/materials/profile/manifest.json
MATERIALS_CANDIDATE_PROFILE_PATH=/var/lib/job-hunter-automation/materials/profile/candidate-profile.json
MATERIALS_FACT_CATALOG_PATH=/var/lib/job-hunter-automation/materials/profile/fact-catalog.json
MATERIALS_WRITING_STYLE_PATH=/var/lib/job-hunter-automation/materials/profile/writing-style.json
MATERIALS_OUTPUT_SCHEMA_PATH=/opt/job-hunter-automation/contracts/application-materials/v1/generation-output.schema.json
