[Unit]
Description=Job Hunter automation health runner
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=job-hunter-automation
Group=job-hunter-automation
WorkingDirectory=/var/lib/job-hunter-automation/canary-workspace
EnvironmentFile=/etc/job-hunter-automation/runner.env
Environment=DISPLAY=:99
Environment=NODE_ENV=production
ExecStart=/usr/bin/xvfb-run --server-num=99 --server-args="-screen 0 1280x900x24 -nolisten tcp -noreset" /usr/bin/node /opt/job-hunter-automation/dist/launcher.js
Restart=on-failure
RestartSec=15
TimeoutStopSec=15
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/job-hunter-automation

[Install]
WantedBy=multi-user.target
